# Copy this file to .env for local development.
# In Azure Static Web Apps, these VITE_* values must instead be set as
# GitHub Actions secrets (see README > Deploy to Azure Static Web Apps),
# because Vite inlines them at BUILD time, not at server runtime.

# Supabase project URL and anon (public) key. The anon key is safe to ship
# to the browser: it only has access to what your Supabase policies allow,
# and this app uses it solely to list files in the two PUBLIC storage
# buckets below (read-only).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Bucket names exactly as created in Supabase Storage. Defaults already
# match "Vientos" and "Yareta" if you leave these unset.
VITE_SUPABASE_BUCKET_VIENTOS=Vientos
VITE_SUPABASE_BUCKET_YARETA=Yareta

# Base path the frontend calls for its own protected API handlers.
# "/api" is correct for Azure Static Web Apps (it proxies to the Functions
# app under api/ automatically) and for `swa start` locally. Only change
# this if you deploy the API somewhere else.
VITE_API_BASE_URL=/api

# Optional: shown in the contact section only when set.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
